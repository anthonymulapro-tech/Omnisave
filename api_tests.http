### . Test : Mettre à jour un lien (Vérifier la limite de 5 catégories)
# Remplace le '1' dans l'URL par l'ID du lien que tu viens de créer
PUT http://127.0.0.1:5000/api/links/2
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoyLCJleHAiOjE3ODk1MDc0MzAsImlhdCI6MTc4OTQyMTAzMCwiaXNzIjoib21uaXNhdmUtYXBpIiwianRpIjoiMmNlYmRhOTUtYTk0OS00NGE2LWI3NWQtYmYzMTdkZjgyNTdhIn0.NMx2KarnngEDxYw625cj9im12F-tEH8x4DKAj6evnQ8

{
    "title": "Titre mis à jour",
    "categories": ["Cooking", "React", "Python", "SQL", "Flask"],
    "tags": ["Fullstack"]
}


### 5. 🆕 MODIFIER UN LIEN (Remplace le "35" à la fin par un vrai ID de ta base)
PUT http://localhost:5000/api/links/35
Content-Type: application/json
Authorization: Bearer TON_TOKEN_ACTUEL_ICI

{
  "title": "Titre super modifié depuis le test HTTP !",
  "categories": ["Cooking", "Recette", "Test"],
  "tags": ["tag-modifié", "mise-a-jour", "succes"]
}
### --- GESTION DU PROFIL ---

