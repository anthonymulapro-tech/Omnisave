### 1. Inscription d'un nouvel utilisateur de test
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "email": "postman@omnisave.test",
  "password": "Password123!"
}

### 2. Connexion (Pour récupérer le JWT Token)
# ⚠️ COPIE LE TOKEN REÇU DANS LA RÉPONSE
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "postman@omnisave.test",
  "password": "Password123!"
}


### --- NOUVEAU FLUX DE CRÉATION ---

### 3a. Prévisualisation d'un lien (L'IA analyse mais ne sauvegarde pas)
POST http://localhost:5000/api/links/preview
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoyLCJleHAiOjE3ODk1MDExOTMsImlhdCI6MTc4OTQxNDc5M30.7sAOvTvyPVSdiYeQTD42KJue5_BOEwDg6EOWtTm7RIg

{
  "url": "https://www.instagram.com/reels/DdHV-EeodO7/"
}

### 3b. Sauvegarde finale d'un lien (Après validation du tiroir)
POST http://localhost:5000/api/links
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoyLCJleHAiOjE3ODk1MDExOTMsImlhdCI6MTc4OTQxNDc5M30.7sAOvTvyPVSdiYeQTD42KJue5_BOEwDg6EOWtTm7RIg

{
  "url": "https://www.instagram.com/reels/DdHV-EeodO7/",
  "title": "Vidéo Instagram incroyable",
  "category": "Sport",
  "tags": ["sport", "instagram", "test"]
}


### --- RÉCUPÉRATION ET MODIFICATION ---

### 4. Récupérer tous les liens de l'utilisateur
GET http://localhost:5000/api/links
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTc4NTAsImlhdCI6MTc4OTMzMTQ1MH0.tcUJRvr5AnAhlyLGVvQLR2pv2gGvHbjaD_m17uyA6Jo


### 5. 🆕 MODIFIER UN LIEN (Remplace le "1" à la fin par un vrai ID de ta base)
PUT http://localhost:5000/api/links/35
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTc4NTAsImlhdCI6MTc4OTMzMTQ1MH0.tcUJRvr5AnAhlyLGVvQLR2pv2gGvHbjaD_m17uyA6Jo

{
  "title": "Titre super modifié depuis le test HTTP !",
  "category": "Cooking",
  "tags": ["tag-modifié", "mise-a-jour", "succes"]
}

### --- GESTION DU PROFIL ---

### 6. Récupérer son profil
GET http://localhost:5000/api/profile
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTgyMjksImlhdCI6MTc4OTMzMTgyOX0.ClwJOuyBu2LUiTKSVDXZtidndpO5t9xdiOvEzDRws5o


### 7. Modifier son profil (Prénom, Nom, Pseudo, Fast-Save, Pays)
PUT http://localhost:5000/api/profile
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTgyMjksImlhdCI6MTc4OTMzMTgyOX0.ClwJOuyBu2LUiTKSVDXZtidndpO5t9xdiOvEzDRws5o

{
  "first_name": "Anthony",
  "last_name": "Mula",
  "pseudo": "Anthodev2",
  "fast_save": true,
  "country": "France"
}


### 8. Supprimer son compte (Efface l'utilisateur et tous ses liens)
DELETE http://localhost:5000/api/profile
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo0LCJleHAiOjE3ODk0MTc0MDYsImlhdCI6MTc4OTMzMTAwNn0.XxLP8uGhaq3cvpomQOeQdnN0J8Ct0YOj23BcjVlpdQc

### --- GESTION DU PROFIL (SUITE) ---

### 9. Modifier le profil avec un NOUVEL email
# Remplace "nouveau.mail@ example.com" par un email de test.
# Si tu mets un email déjà utilisé par un autre compte, tu dois recevoir une erreur 409.
PUT http://localhost:5000/api/profile
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTgyMjksImlhdCI6MTc4OTMzMTgyOX0.ClwJOuyBu2LUiTKSVDXZtidndpO5t9xdiOvEzDRws5o

{
  "email": "nouveau.mail2@example.com",
  "first_name": "Anthony",
  "last_name": "Mula",
  "pseudo": "Anthodev2",
  "fast_save": true,
  "country": "France"
}


### --- SÉCURITÉ : MOT DE PASSE ---

### 10. Modifier son mot de passe (ÉCHEC : mauvais ancien mot de passe)
# Doit retourner une erreur 401 "Incorrect current password."
PUT http://localhost:5000/api/profile/password
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTgyMjksImlhdCI6MTc4OTMzMTgyOX0.ClwJOuyBu2LUiTKSVDXZtidndpO5t9xdiOvEzDRws5o

{
  "old_password": "mauvais_mot_de_passe_123",
  "new_password": "SuperNouveauPassword456!"
}


### 11. Modifier son mot de passe (SUCCÈS)
# Remplace "ton_vrai_ancien_mot_de_passe" par celui avec lequel tu t'es connecté.
# Doit retourner un succès 200.
PUT http://localhost:5000/api/profile/password
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTgyMjksImlhdCI6MTc4OTMzMTgyOX0.ClwJOuyBu2LUiTKSVDXZtidndpO5t9xdiOvEzDRws5o

{
  "old_password": "Password123!",
  "new_password": "SuperNouveauPassword456!"
}

### 12. Toggle Favorite Status
PUT http://127.0.0.1:5000/api/links/2/favorite
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoyLCJleHAiOjE3ODk1MDExOTMsImlhdCI6MTc4OTQxNDc5M30.7sAOvTvyPVSdiYeQTD42KJue5_BOEwDg6EOWtTm7RIg

{
  "is_favorite": false
}