### --- GESTION DU PROFIL (SUITE) ---

### 9. Modifier le profil avec un NOUVEL email
# Remplace "nouveau.mail@ example.com" par un email de test.
# Si tu mets un email déjà utilisé par un autre compte, tu dois recevoir une erreur 409.
PUT http://localhost:5000/api/profile
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTgyMjksImlhdCI6MTc4OTMzMTgyOX0.ClwJOuyBu2LUiTKSVDXZtidndpO5t9xdiOvEzDRws5o

{
  "email": "nouveau.mail2@example.com",
  "first_name": "Anthony",
  "last_name": "Mula",
  "pseudo": "Anthodev2",
  "fast_save": true,
  "country": "France"
}


### --- SÉCURITÉ : MOT DE PASSE ---

### 10. Modifier son mot de passe (ÉCHEC : mauvais ancien mot de passe)
# Doit retourner une erreur 401 "Incorrect current password."
PUT http://localhost:5000/api/profile/password
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTgyMjksImlhdCI6MTc4OTMzMTgyOX0.ClwJOuyBu2LUiTKSVDXZtidndpO5t9xdiOvEzDRws5o

{
  "old_password": "mauvais_mot_de_passe_123",
  "new_password": "SuperNouveauPassword456!"
}


### 11. Modifier son mot de passe (SUCCÈS)
# Remplace "ton_vrai_ancien_mot_de_passe" par celui avec lequel tu t'es connecté.
# Doit retourner un succès 200.
PUT http://localhost:5000/api/profile/password
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo1LCJleHAiOjE3ODk0MTgyMjksImlhdCI6MTc4OTMzMTgyOX0.ClwJOuyBu2LUiTKSVDXZtidndpO5t9xdiOvEzDRws5o

{
  "old_password": "Password123!",
  "new_password": "SuperNouveauPassword456!"
}

