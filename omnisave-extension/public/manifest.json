{
  "manifest_version": 3,
  "name": "Omnisave - Fast Save",
  "version": "1.0",
  "description": "Quickly save links to Omnisave with AI auto-categorization.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Save to Omnisave"
  },
  "background": {
    "service_worker": "background.js"
  }
}